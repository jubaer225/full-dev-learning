{%- comment -%} 
    Welcome to your Shopify theme's homepage template!
     
    This template is displayed when visitors go to your store's homepage.
    Learn more about Liquid templating at https://shopify.dev/docs/themes/liquid/reference 
{%- endcomment -%}

<section class="hero">
  <div class="container">
    <h1>Welcome to {{ shop.name }}</h1>
    <p>Your store's homepage - customize this content in the theme editor!</p>
  </div>
</section>

{%- if collections.featured -%}
  <section class="featured-collection">
    <div class="container">
      <h2>{{ collections.featured.title }}</h2>
      <div class="products-grid">
        {%- for product in collections.featured.products limit: 8 -%}
          <div class="product-card">
            <a href="{{ product.url }}">
              {%- if product.featured_image -%}
                <img
                  src="{{ product.featured_image | image_url: width: 300 }}"
                  alt="{{ product.featured_image.alt }}"
                  width="300"
                  height="300" />
              {%- endif -%}
              <h3>{{ product.title }}</h3>
              <p class="price">{{ product.price | money }}</p>
            </a>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}