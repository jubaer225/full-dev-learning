{%- comment -%} 
  Example Hero Section Component
   
  This is a reusable section that can be added to any page.
  Sections are customizable components that store owners can configure in the theme editor. 
{%- endcomment -%}

{% schema %}
  {
    "name": "Hero Banner",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default": "Welcome to our store"
      }, {
        "type": "textarea",
        "id": "description",
        "label": "Description",
        "default": "This is your hero section where you can tell your story"
      }, {
        "type": "color",
        "id": "background_color",
        "label": "Background Color",
        "default": "#f5f5f5"
      }
    ],
    "presets": [
      {
        "name": "Hero Banner"
      }
    ]
  }
{% endschema %}

<section class="hero-section" style="background-color: {{ section.settings.background_color }}">
  <div class="container">
    <h1>{{ section.settings.title }}</h1>
    <p>{{ section.settings.description }}</p>
  </div>
</section>

<style>
  .hero-section {
    padding: 3rem 2rem;
    text-align: center;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .hero-section h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .hero-section p {
    font-size: 1.25rem;
  }

  @media (max-width: 768px) {
    .hero-section h1 {
      font-size: 1.75rem;
    }

    .hero-section p {
      font-size: 1rem;
    }
  }
</style>